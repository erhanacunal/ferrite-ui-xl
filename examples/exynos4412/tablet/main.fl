// main.fl — the tablet demo's home screen.
//
// - Two pages (swipe left/right): a glance clock + live performance card
//   with four apps, and an "about" card with live system figures.
// - The dock holds four more apps; swipe up for the app drawer: a scrolling
//   grid (lib/flex.fl GridView) of all eight and every installed app package
//   (ferrite-ui-xl docs/apps.md: a tap starts one beside the tablet with
//   startApp; the home gesture, a swipe up from the bottom edge, comes back
//   here while it keeps running).
// - Swipe down for the shade: brightness and volume sliders (real backlight
//   and codec volume), quick tiles and a notification. The GPS tile turns
//   the receiver on and off (lib/gps.fl) and shows its state; it stays as
//   set while apps run.
// - Tapping an app grows its colour from the icon to the full screen, then
//   starts the app's program; coming back shrinks it into the icon again.
//
// State shared with the apps travels in the runProgram argument (ui.fl).

#include "ui.fl"
#include "gesture.fl"
#include "apps.fl"
#include "flex.fl"
#include "gps.fl"

#hint_widgets 140 140

// --- Layout ---
const ICON_D   = 104;   // home / drawer icon circle
const DOCK_D   = 88;
const DOCK_Y   = 652;
const ROW_Y    = 430;   // centre of the page-0 app row
const SHADE_H  = 480;
const QS_W     = 228;   // quick tile width: five in 1192 px, 13 px apart
const HIST     = 48;    // performance graph samples

// --- Hit table: the home and dock app icons ---
var hit_w[20];
var hit_app[20];
var hit_x[20];      // centre, in its container
var hit_y[20];
var hit_where[20];  // 0 page 0, 1 page 1, 2 dock
var hits = 0;

// Clickable widgets need one file-scope variable each (on_click wiring).
var ic0; var ic1; var ic2; var ic3;           // page 0
var dk0; var dk1; var dk2; var dk3;           // dock
var bright_sl; var vol_sl;
var tile_perf; var tile_wall; var tile_chime; var tile_restart; var tile_gps;
var gps_lbl;        // the GPS tile's caption
var scrim;
var drawer_handle;
var notif;
// The drawer's grid: one tile per app, its circle's value = the app
// (APP_*), or PKG_BASE + i for installed package i.
const DRAWER_COLS = 6;
const TILE_W      = 190;
const TILE_H      = 168;
const PKG_BASE    = 100;
const PKG_COLOR   = 0x4A69;
var drawer_grid;
var pkg_status;

// A drawer tile: a transparent box holding the circle and the name under it.
widget DrawerTile : Label(size: [190, 168]);
widget DrawerIcon : Button(location: [43, 8], size: [104, 104], border_radius: 52, clickable: 1);
widget DrawerName : Label(location: [0, 122], size: [190, 32], font_id: F20, text_color: WHITE,
                          text_align: ALIGN_CENTER);

var pager;
var pager_drag = 0;      // a finger is dragging the pager
var pager_drag_end = 0;  // millis() when the last drag ended
var page_dot0; var page_dot1;
var glance_time; var glance_date;
var perf_big; var perf_sub; var perf_graph;
var about_sys; var about_obj;
var shade; var shade_time; var shade_date; var bright_lbl; var vol_lbl;
var drawer;
var launch;
var perf_lbl;
var dock;

var perf_hist[48];
var perf_seeded = 0;
var shade_open = 0;
var drawer_open = 0;
var launching = 0;
var launch_app = 0;
var restart_armed = 0;
var restart_at = 0;
var notif_gone = 0;

var last_sec = 0;
var last_passes = 0;
var last_frames = 0;

// ============================================================
// Building
// ============================================================

// An app icon centred at (cx, cy) in `p`: coloured circle + glyph, and the
// app's name under it when `named`. `b` is the circle (clickable).
fn make_icon(b: widget, p: widget, app, cx, cy, d, named, where) {
    target(b);
    style_button(cx - d / 2, cy - d / 2, d, d, app_color(app), d / 2);
    parent(p);
    add_icon(b, d, d, app_glyph(app));
    if (named) {
        var l = alloc();
        style_label(cx - 80, cy + d / 2 + 6, 160, 32, F20, WHITE, ALIGN_CENTER, app_title(app));
        parent(p);
    }
    hit_w[hits] = b;
    hit_app[hits] = app;
    hit_x[hits] = cx;
    hit_y[hits] = cy;
    hit_where[hits] = where;
    hits++;
}

// Translucent rounded panel ("glass").
fn style_glass(x, y, w, h, a) {
    style_box(x, y, w, h, WHITE, 28);
    set(alpha, a);
}

// Transparent container (a label without text draws nothing).
fn style_group(x, y, w, h) {
    set(kind, KIND_LABEL);
    set(location, x, y);
    set(size, w, h);
}

// The gradient and its three translucent blobs are one opaque picture
// (make_assets.py `make_wallpapers`): restoring behind a sliding page copies
// it instead of re-blending the blobs. The root's colour stays what
// anti-aliased edges and see-through widgets assume is behind them.
fn build_wallpaper() {
    target(0);
    set(bg_color, (ui_flags & 2) ? WALL2_TOP : WALL_TOP);
    set(image_id, (ui_flags & 2) ? IMG_WALL2 : IMG_WALL1);
}

fn build_page0(pg: widget) {
    glance_time = alloc();
    style_label(60, 70, 700, 150, F120, WHITE, ALIGN_LEFT, "");
    parent(pg);
    glance_date = alloc();
    style_label(68, 222, 700, 40, F26, WHITE, ALIGN_LEFT, "");
    parent(pg);
    var sub = alloc();
    style_label(68, 262, 700, 32, F20, DIM, ALIGN_LEFT, "ferrite-ui  ·  bare-metal Rust, no OS");
    parent(pg);

    // Live performance card
    var card = alloc();
    style_glass(808, 70, 420, 250, 34);
    parent(pg);
    var t = alloc();
    style_label(28, 18, 360, 28, F20, DIM, ALIGN_LEFT, "Live performance");
    parent(card);
    perf_big = alloc();
    style_label(26, 52, 360, 64, F60, WHITE, ALIGN_LEFT, "- fps");
    parent(card);
    perf_sub = alloc();
    style_label(28, 118, 380, 28, F16, DIM, ALIGN_LEFT, "");
    parent(card);
    perf_graph = alloc();
    target(perf_graph);
    set(kind, KIND_GRAPH);
    set(location, 24, 150);
    set(size, 372, 84);
    set(alpha, 0);
    set(text_color, ACCENT);
    set(gradient_color, 0x2A4F);
    set(graph_flags, 2);
    set(graph_arr, perf_hist);
    set(visible, OFF);   // until the first sample
    parent(card);

    ic0 = alloc(); make_icon(ic0, pg, APP_CLOCK, 340, ROW_Y, ICON_D, 1, 0); target(ic0); set(on_click, @on_icon);
    ic1 = alloc(); make_icon(ic1, pg, APP_CALC, 540, ROW_Y, ICON_D, 1, 0); target(ic1); set(on_click, @on_icon);
    ic2 = alloc(); make_icon(ic2, pg, APP_PAINT, 740, ROW_Y, ICON_D, 1, 0); target(ic2); set(on_click, @on_icon);
    ic3 = alloc(); make_icon(ic3, pg, APP_MONITOR, 940, ROW_Y, ICON_D, 1, 0); target(ic3); set(on_click, @on_icon);
}

fn build_page1(pg: widget) {
    var card = alloc();
    style_glass(160, 70, 960, 470, 30);
    parent(pg);
    var t = alloc();
    style_label(48, 30, 860, 50, F36, WHITE, ALIGN_LEFT, "About this tablet");
    parent(card);
    var body = alloc();
    style_label(48, 96, 860, 200, F20, WHITE, ALIGN_LEFT,
        "Every pixel here comes from ferrite-ui: a widget framework and\nbytecode VM written in Rust, running bare metal on the\nSamsung Exynos 4412 (4x Cortex-A9). No Linux, no Android.\nThe G2D engine copies each frame to the display.");
    set(multi_line, ON);
    parent(card);
    about_sys = alloc();
    style_label(48, 320, 860, 40, F26, ACCENT, ALIGN_LEFT, "");
    parent(card);
    about_obj = alloc();
    style_label(48, 364, 860, 40, F26, ACCENT, ALIGN_LEFT, "");
    parent(card);
    var hint = alloc();
    style_label(48, 414, 860, 32, F16, DIM, ALIGN_LEFT, "Swipe up for all apps, down for quick settings.");
    parent(card);
}

fn build_dock() {
    dock = alloc();
    style_glass(360, DOCK_Y - 4, 560, 120, 40);
    set(border_radius, 40);
    parent(0);
    dk0 = alloc(); make_icon(dk0, dock, APP_GALLERY, 100, 60, DOCK_D, 0, 2); target(dk0); set(on_click, @on_icon);
    dk1 = alloc(); make_icon(dk1, dock, APP_MUSIC, 220, 60, DOCK_D, 0, 2); target(dk1); set(on_click, @on_icon);
    dk2 = alloc(); make_icon(dk2, dock, APP_NOTES, 340, 60, DOCK_D, 0, 2); target(dk2); set(on_click, @on_icon);
    dk3 = alloc(); make_icon(dk3, dock, APP_SETTINGS, 460, 60, DOCK_D, 0, 2); target(dk3); set(on_click, @on_icon);
}

// The drawer and the shade are opaque: a panel that only slides keeps its
// pixels, which the renderer then moves instead of redrawing them (only the
// strip coming into view is drawn). A translucent one would show the
// wallpaper moving with it, so it is redrawn whole every frame.
//
// Its apps are a GridView: DRAWER_COLS centred tiles a row, scrolling once
// there are more rows than fit. A drag that scrolls it is no swipe, so it
// doesn't close the drawer (the handle and a swipe down elsewhere do).
fn build_drawer() {
    // Layer 2: it slides over the pager (layer 1), which keeps its window
    // (a plain widget over it would hand the pager back to the tree).
    drawer = Box(parent: 0, location: [0, SCREEN_H], size: [SCREEN_W, SCREEN_H - STATUS_H],
                 bg_color: APP_BG, border_radius: 32, layer: 2, children: [
        drawer_handle = Label(location: [440, 0], size: [400, 44], clickable: 1,
                              on_click: @on_drawer_handle, children: [
            Box(location: [160, 18], size: [80, 6], bg_color: DIM, border_radius: 3),
        ]),
        Label(text: "All apps", location: [80, 44], size: [600, 50], font_id: F26,
              text_color: WHITE, text_align: ALIGN_LEFT),
        pkg_status = Label(location: [600, 44], size: [600, 50], font_id: F20,
                           text_color: DIM, text_align: ALIGN_RIGHT),
        drawer_grid = GridView(location: [40, 100], size: [SCREEN_W - 80, SCREEN_H - STATUS_H - 116],
                               grid_cols: DRAWER_COLS, flex: FLEX_GRID | JUSTIFY_CENTER | FLEX_AUTO,
                               flex_gap: 8, bg_color: APP_BG),
    ]);
    for (var app = APP_CLOCK; app <= APP_SETTINGS; app++) {
        add_drawer_tile(app, app_color(app));
    }
    // The installed packages (appCount / appName): none installed, or no
    // app storage, leaves a hint instead.
    var n = appCount();
    if (n == 0) {
        pkg_status.text = "No packages: ferrite_cli app install PACKAGE.bin";
    }
    for (var i = 0; i < n; i++) {
        add_drawer_tile(PKG_BASE + i, PKG_COLOR);
    }
}

// The drawer tile for `v` (an APP_* or PKG_BASE + package index).
fn add_drawer_tile(v, color) {
    var name = v >= PKG_BASE ? appName(v - PKG_BASE) : app_title(v);
    var b;
    DrawerTile(parent: drawer_grid, children: [
        b = DrawerIcon(value: v, bg_color: color, press_color: lighten(color)),
        DrawerName(text: name),
    ]);
    if (v >= PKG_BASE) {
        // A package's plain glyph.
        Box(parent: b, location: [32, 32], size: [40, 40], bg_color: WHITE, border_radius: 10);
    } else {
        Image(parent: b, size: [ICON_D, ICON_D], image_id: app_glyph(v));
    }
    onGesture(b, GESTURE_TAP, @on_drawer_tap);
    strClear();
}

// A drawer circle tapped: an app grows from where its circle is on the
// screen (the grid may be scrolled); a package starts beside the tablet.
fn on_drawer_tap(w: widget, ev) {
    if (ev != GE_TAP || launching) {
        return 0;
    }
    var v = w.value;
    if (v >= PKG_BASE) {
        start_package(v - PKG_BASE);
        return 0;
    }
    launching = 1;
    launch_app = v;
    playSound("click");
    grow(gestureInfo(GI_X) - gestureInfo(GI_LOCAL_X) + ICON_D / 2,
         gestureInfo(GI_Y) - gestureInfo(GI_LOCAL_Y) + ICON_D / 2, v);
}

// Package `slot` started (or shown, if it runs).
fn start_package(slot) {
    playSound("click");
    var t = startApp(appId(slot));
    if (t < 0) {
        pkg_status.text = t == -2 ? "four apps already run" : sprintf("could not start it (%d)", t);
    } else {
        pkg_status.text = "";
        // Back from it (home gesture) to the home screen, not the drawer.
        open_drawer(0);
    }
    strClear();
}

// Quick tile `n` (0..4): icon + caption `l` in a pill.
fn make_tile(b: widget, l: widget, n, img, text) {
    target(b);
    style_button(44 + n * (QS_W + 13), 300, QS_W, 76, SURFACE_HI, 38);
    parent(shade);
    var i = alloc();
    style_image(14, 0, 40, 76, img);
    parent(b);
    target(l);
    style_label(58, 0, QS_W - 62, 76, F20, WHITE, ALIGN_LEFT, text);
    parent(b);
}

fn build_shade() {
    scrim = alloc();
    style_box(0, 0, SCREEN_W, SCREEN_H, BLACK, 0);
    set(alpha, 140);
    set(visible, OFF);
    set(clickable, ON);
    set(on_click, @on_scrim);
    parent(0);
    set(layer, 3);

    shade = alloc();
    style_box(0, -SHADE_H - 32, SCREEN_W, SHADE_H + 32, SURFACE, 32);
    parent(0);
    set(layer, 4);
    // Content sits 32 px down: the top corners stay off screen.
    shade_time = alloc();
    style_label(44, 50, 400, 70, F60, WHITE, ALIGN_LEFT, "");
    parent(shade);
    shade_date = alloc();
    style_label(48, 118, 600, 30, F20, DIM, ALIGN_LEFT, "");
    parent(shade);

    var bi = alloc();
    style_image(44, 168, 40, 44, IMG_QS_BRIGHT);
    parent(shade);
    bright_sl = alloc();
    style_slider(100, 174, 1020, ACCENT);
    set(value, brightness());
    set(on_click, @on_bright);
    parent(shade);
    bright_lbl = alloc();
    style_label(1136, 168, 100, 44, F20, WHITE, ALIGN_RIGHT, "");
    parent(shade);

    var vi = alloc();
    style_image(44, 228, 40, 44, IMG_QS_VOLUME);
    parent(shade);
    vol_sl = alloc();
    style_slider(100, 234, 1020, ACCENT);
    set(value, ui_volume);
    set(on_click, @on_volume);
    parent(shade);
    vol_lbl = alloc();
    style_label(1136, 228, 100, 44, F20, WHITE, ALIGN_RIGHT, "");
    parent(shade);

    tile_perf = alloc();    make_tile(tile_perf, alloc(), 0, IMG_QS_PERF, "Performance"); target(tile_perf); set(on_click, @on_tile);
    tile_wall = alloc();    make_tile(tile_wall, alloc(), 1, IMG_QS_DARK, "Wallpaper"); target(tile_wall); set(on_click, @on_tile);
    tile_chime = alloc();   make_tile(tile_chime, alloc(), 2, IMG_QS_VOLUME, "Chime"); target(tile_chime); set(on_click, @on_tile);
    tile_gps = alloc();     gps_lbl = alloc(); make_tile(tile_gps, gps_lbl, 3, IMG_QS_GPS, ""); target(tile_gps); set(on_click, @on_tile);
    tile_restart = alloc(); make_tile(tile_restart, alloc(), 4, IMG_QS_RESTART, "Restart"); target(tile_restart); set(on_click, @on_tile);

    notif = alloc();
    style_button(44, 400, 1192, 64, SURFACE_HI, 20);
    set(on_click, @on_notif);
    parent(shade);
    var nt = alloc();
    style_label(24, 0, 1140, 64, F20, WHITE, ALIGN_LEFT,
        "Welcome to ferrite-ui  ·  tap to dismiss");
    parent(notif);

    var grip = alloc();
    style_box(600, SHADE_H + 14, 80, 6, DIM, 3);
    parent(shade);
    show_levels();
    show_tiles();
}

fn build_launch() {
    launch = alloc();
    style_box(0, 0, ICON_D, ICON_D, WHITE, ICON_D / 2);
    set(visible, OFF);
    parent(0);
}

// ============================================================
// Updating
// ============================================================

fn show_clock() {
    var now = rtcRead();
    var s = sprintf("%d:%02d", now[2], now[1]);
    var d = sprintf("%s, %d %s", day_name(now[4]), now[3], month_name(now[5]));
    arrFree(now);
    target(glance_time); set(text, s); dirty();
    target(glance_date); set(text, d); dirty();
    target(shade_time); set(text, s); dirty();
    target(shade_date); set(text, d); dirty();
    strClear();
}

fn show_levels() {
    target(bright_lbl); set(text, sprintf("%d%%", brightness())); dirty();
    target(vol_lbl); set(text, sprintf("%d%%", ui_volume)); dirty();
    ui_status_levels();
    strClear();
}

fn show_tiles() {
    target(tile_perf);
    set(bg_color, (ui_flags & 1) ? ACCENT : SURFACE_HI);
    dirty();
    target(tile_wall);
    set(bg_color, (ui_flags & 2) ? ACCENT : SURFACE_HI);
    dirty();
    target(tile_restart);
    set(bg_color, restart_armed ? RED : SURFACE_HI);
    dirty();
    target(perf_lbl);
    set(visible, ui_flags & 1);
    dirty();
    show_gps();
}

// The GPS tile: lit while the receiver is on, its state as the caption.
fn show_gps() {
    var st = gpsState();
    target(tile_gps);
    set(bg_color, st == GPS_OFF ? SURFACE_HI : ACCENT);
    dirty();
    target(gps_lbl);
    if (st == GPS_FIX) {
        set(text, sprintf("GPS  ·  %d sats", gpsGet(GPS_SATS_USED)));
    } else if (st == GPS_SEARCHING) {
        set(text, "Searching");
    } else if (st == GPS_NO_DATA) {
        set(text, "GPS starting");
    } else {
        set(text, "GPS off");
    }
    dirty();
    strClear();
}

fn show_page() {
    target(page_dot0);
    set(bg_color, ui_page == 0 ? WHITE : FAINT);
    dirty();
    target(page_dot1);
    set(bg_color, ui_page == 1 ? WHITE : FAINT);
    dirty();
}

// Once a second: frames and loop passes per second, the graph, the about
// card's figures.
fn sample_perf(dt) {
    var p = sysPasses();
    var f = sysFrames();
    var fps = (f - last_frames) * 1000 / dt;
    var pps = (p - last_passes) * 1000 / dt;
    last_frames = f;
    last_passes = p;
    for (var i = 0; i < HIST - 1; i++) {
        // The first sample fills the whole graph.
        perf_hist[i] = perf_seeded ? perf_hist[i + 1] : fps;
    }
    perf_hist[HIST - 1] = fps;
    perf_seeded = 1;
    target(perf_graph); set(visible, ON); dirty();
    target(perf_big); set(text, sprintf("%d fps", fps)); dirty();
    var mhz = sysCpuMhz();
    target(perf_sub);
    if (mhz > 0) {
        set(text, sprintf("%d loop passes/s  ·  CPU0 %d MHz", pps, mhz));
    } else {
        set(text, sprintf("%d loop passes/s", pps));
    }
    dirty();
    target(perf_lbl);
    set(text, sprintf("%d fps  ·  %d passes/s", fps, pps));
    dirty();
    target(about_sys);
    var ht = sysHeapTotalKb();
    if (ht > 0) {
        set(text, sprintf("Heap %d / %d MB  ·  object arena %d / %d KB", sysHeapUsedKb() / 1024, ht / 1024,
                          sysObjUsedKb(), sysObjTotalKb()));
    } else {
        set(text, sprintf("Object arena %d / %d KB", sysObjUsedKb(), sysObjTotalKb()));
    }
    dirty();
    target(about_obj);
    set(text, sprintf("%d widgets  ·  %d strings  ·  %d arrays", sysObjCount(1), sysObjCount(2), sysObjCount(3)));
    dirty();
    strClear();
    show_gps();
}

// ============================================================
// Pages, drawer, shade
// ============================================================

fn go_page(p) {
    if (p == ui_page) {
        return 0;
    }
    settle_page(p, 360);
}

// Slides the pager to page p from wherever it is.
fn settle_page(p, ms) {
    ui_page = p;
    animate(pager, PROP_LOC_X, -SCREEN_W * p, ms, EASE_OUT);
    show_page();
}

// The pager follows a horizontal drag; on release it settles on the page a
// fling points to, else on the one showing most.
fn pager_gesture(w, e) {
    if (e == GE_DRAG_START) {
        if (launching || shade_open || drawer_open) {
            return 0;
        }
        pager_drag = 1;
        stopAnimProp(pager, PROP_LOC_X);
    } else if (e == GE_DRAG_UPDATE) {
        if (!pager_drag) {
            return 0;
        }
        target(pager);
        var x = get(loc_x) + gestureInfo(GI_DX);
        // Past either end it moves at a third of the finger's speed.
        if (x > 0 || x < -SCREEN_W) {
            x = get(loc_x) + gestureInfo(GI_DX) / 3;
        }
        if (x > SCREEN_W / 4) { x = SCREEN_W / 4; }
        if (x < -SCREEN_W - SCREEN_W / 4) { x = -SCREEN_W - SCREEN_W / 4; }
        set(loc_x, x);
    } else if (e == GE_DRAG_END) {
        if (!pager_drag) {
            return 0;
        }
        pager_drag = 0;
        pager_drag_end = millis();
        target(pager);
        var at = get(loc_x);
        var vx = gestureInfo(GI_VX);
        var p = at < -SCREEN_W / 2 ? 1 : 0;
        if (vx < -300) { p = 1; }
        if (vx > 300) { p = 0; }
        // Time for the rest of the way: shorter the less is left.
        var left = at + SCREEN_W * p;
        if (left < 0) { left = -left; }
        settle_page(p, 120 + left * 240 / SCREEN_W);
    }
}

fn open_drawer(open) {
    drawer_open = open;
    animate(drawer, PROP_LOC_Y, open ? STATUS_H : SCREEN_H, 320, EASE_OUT);
}

// The scrim dims the home screen behind the shade. It switches at once
// (on as the shade starts to open, off once it has closed) rather than
// fading: a translucent full-screen widget changing in place recomposites
// everything under it, so a fade cost a whole-screen redraw every frame of
// the slide.
fn open_shade(open) {
    shade_open = open;
    if (open) {
        animate(shade, PROP_LOC_Y, -32, 320, EASE_OUT);
        target(scrim);
        // No dirty(): showing or hiding is a redraw by itself in the tree,
        // and only a window placement for a layer (a dirty mark would
        // redraw and copy the whole 1280x800 scrim surface).
        set(visible, ON);
    } else {
        animate(shade, PROP_LOC_Y, -SHADE_H - 32, 320, EASE_OUT, @on_shade_closed);
    }
    restart_armed = 0;
    show_tiles();
}

fn on_shade_closed(w, prop) {
    if (!shade_open) {
        target(scrim);
        set(visible, OFF);
    }
}

fn on_swipe(dir, w, delta) {
    if (launching) {
        return 0;
    }
    if (shade_open) {
        if (dir == SWIPE_UP) { open_shade(0); }
        return 0;
    }
    if (drawer_open) {
        if (dir == SWIPE_DOWN) { open_drawer(0); }
        return 0;
    }
    // A swipe on the pager is its drag (pager_gesture); one elsewhere pages too.
    var dragged = pager_drag || millis() - pager_drag_end < 300;
    if (dir == SWIPE_LEFT && !dragged) { go_page(1); }
    if (dir == SWIPE_RIGHT && !dragged) { go_page(0); }
    if (dir == SWIPE_DOWN) { open_shade(1); }
    if (dir == SWIPE_UP) { open_drawer(1); }
}

fn on_scrim(w) {
    open_shade(0);
}

fn on_drawer_handle(w) {
    open_drawer(0);
}

// ============================================================
// Launch / close animation
// ============================================================

// Screen centre of hit-table entry i.
fn hit_screen_x(i) {
    var where = hit_where[i];
    if (where == 0) { return hit_x[i] - ui_page * SCREEN_W; }
    if (where == 2) { return 360 + hit_x[i]; }
    return hit_x[i];
}

fn hit_screen_y(i) {
    var where = hit_where[i];
    if (where == 2) { return DOCK_Y - 4 + hit_y[i]; }
    return STATUS_H + hit_y[i];
}

// The launch colour grows from an icon centred at (x, y) on the screen.
fn grow(x, y, app) {
    target(launch);
    set(location, x - ICON_D / 2, y - ICON_D / 2);
    set(size, ICON_D, ICON_D);
    set(border_radius, ICON_D / 2);
    set(bg_color, app_color(app));
    set(alpha, 255);
    set(visible, ON);
    dirty();
    animate(launch, PROP_LOC_X, 0, 260, EASE_IN_OUT);
    animate(launch, PROP_LOC_Y, 0, 260, EASE_IN_OUT);
    animate(launch, PROP_BORDER_RADIUS, 0, 260, EASE_IN_OUT);
    animate(launch, PROP_SIZE_H, SCREEN_H, 260, EASE_IN_OUT);
    animate(launch, PROP_SIZE_W, SCREEN_W, 260, EASE_IN_OUT, @on_grown);
}

fn on_grown(w, prop) {
    runProgram(app_program(launch_app), ui_arg(0));
}

fn on_icon(w) {
    if (launching) {
        return 0;
    }
    for (var i = 0; i < hits; i++) {
        if (hit_w[i] == w) {
            launching = 1;
            launch_app = hit_app[i];
            playSound("click");
            grow(hit_screen_x(i), hit_screen_y(i), launch_app);
        }
    }
}

// Coming back from an app: its colour shrinks into its home icon.
fn shrink(app) {
    var x = SCREEN_W / 2;
    var y = SCREEN_H / 2;
    for (var i = 0; i < hits; i++) {
        if (hit_app[i] == app) {
            if (hit_where[i] == 2 || hit_where[i] == ui_page) {
                x = hit_screen_x(i);
                y = hit_screen_y(i);
            }
        }
    }
    target(launch);
    set(location, 0, 0);
    set(size, SCREEN_W, SCREEN_H);
    set(border_radius, 0);
    set(bg_color, app_color(app));
    set(visible, ON);
    animate(launch, PROP_LOC_X, x - ICON_D / 2, 300, EASE_IN_OUT);
    animate(launch, PROP_LOC_Y, y - ICON_D / 2, 300, EASE_IN_OUT);
    animate(launch, PROP_SIZE_W, ICON_D, 300, EASE_IN_OUT);
    animate(launch, PROP_SIZE_H, ICON_D, 300, EASE_IN_OUT);
    animate(launch, PROP_BORDER_RADIUS, ICON_D / 2, 300, EASE_IN_OUT);
    animate(launch, PROP_ALPHA, 0, 300, EASE_IN, @on_shrunk);
}

fn on_shrunk(w, prop) {
    target(launch);
    set(visible, OFF);
    dirty();
}

// ============================================================
// Shade controls
// ============================================================

fn toggle(v, bit) {
    if (v & bit) {
        return v - bit;
    }
    return v | bit;
}

fn on_bright(w, val) {
    if (val < 5) {
        val = 5;
    }
    setBrightness(val);
    show_levels();
}

fn on_volume(w, val) {
    ui_volume = val;
    setVolume(val);
    show_levels();
}

fn on_tile(w) {
    if (w == tile_perf) {
        ui_flags = toggle(ui_flags, 1);
    }
    if (w == tile_wall) {
        ui_flags = toggle(ui_flags, 2);
        build_wallpaper();
        dirty();
    }
    if (w == tile_chime) {
        playSound("chime");
    }
    if (w == tile_gps) {
        gpsPower(gpsState() == GPS_OFF ? 1 : 0);
    }
    if (w == tile_restart) {
        if (restart_armed) {
            syscall(0x01);   // SYS_REBOOT
        }
        restart_armed = 1;
        restart_at = millis();
    }
    show_tiles();
}

fn on_notif(w) {
    if (notif_gone) {
        return 0;
    }
    notif_gone = 1;
    animate(notif, PROP_LOC_X, SCREEN_W, 300, EASE_IN);
}

// ============================================================

fn setup() {
    ui_read_arg();
    build_wallpaper();
    ui_status_bar();
    perf_lbl = alloc();
    style_label(440, 0, 400, STATUS_H, F16, ACCENT, ALIGN_CENTER, "");
    set(visible, OFF);
    parent(0);

    pager = alloc();
    style_group(-SCREEN_W * ui_page, STATUS_H, SCREEN_W * 2, 560);
    parent(0);
    // Layer 1 (a FIMD window on the board): a page slide moves the window,
    // nothing is redrawn for it.
    set(layer, 1);
    onGesture(pager, GESTURE_HDRAG, @pager_gesture);
    var pg0 = alloc();
    style_group(0, 0, SCREEN_W, 560);
    parent(pager);
    build_page0(pg0);
    var pg1 = alloc();
    style_group(SCREEN_W, 0, SCREEN_W, 560);
    parent(pager);
    build_page1(pg1);

    page_dot0 = alloc();
    style_box(624, 618, 12, 12, WHITE, 6);
    parent(0);
    page_dot1 = alloc();
    style_box(644, 618, 12, 12, FAINT, 6);
    parent(0);

    build_dock();
    build_drawer();
    build_shade();
    build_launch();

    show_page();
    show_clock();
    last_sec = millis();
    last_passes = sysPasses();
    last_frames = sysFrames();
    if (ui_closing != 0) {
        shrink(ui_closing);
    }
    return 0;
}

fn loop() {
    if (ui_tick()) {
        show_clock();
    }
    var t = millis();
    var dt = t - last_sec;
    if (dt >= 1000) {
        last_sec = t;
        sample_perf(dt);
    }
    if (restart_armed && t - restart_at > 3000) {
        restart_armed = 0;
        show_tiles();
    }
    delay(50);
}
