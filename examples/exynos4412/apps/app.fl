// app.fl — the app of the `apps` example, built twice: hello/ and world/ give
// it another application_id (docs/apps.md). Each build is its own app: its own
// EEPROM (byte 0 counts its starts here) and files (START.TXT), so the two
// counters and the launcher's never mix. Started from the launcher (startApp)
// it runs beside it: "Home" shows the launcher and the app keeps counting its
// seconds in the background; "Exit" ends it (exitApp). The tap button comes
// from the library in tapper/ (tapButton), built before the apps.

#include "core.fl"
#include "color.fl"
#include "apps.fl"
#include "storage.fl"

var home;
var quit;
var clock;
var born = 0;
var shown_s = -1;

fn on_button(wid) {
    if (wid == home) {
        showApp(0);
    }
    if (wid == quit) {
        exitApp();
    }
}

fn button(b: widget, x, label: string) {
    target(b);
    set(location, x, 560);
    set(size, 300, 120);
    set(bg_color, 0x2945);
    set(press_color, 0x2C9F);
    set(border_radius, 16);
    set(clickable, ON);
    parent(0);
    var l = alloc();
    target(l);
    set(kind, KIND_LABEL);
    set(size, 300, 120);
    set(text, label);
    set(text_color, WHITE);
    set(text_align, ALIGN_CENTER);
    parent(b);
}

fn setup() {
    var id = currentApp();
    var starts = eepromRead(0);
    if (starts == 255) {
        starts = 0;
    }
    starts = starts + 1;
    eepromWrite(0, starts % 255);
    // A file in the app's own storage root.
    var f = diskOpen("/START.TXT", DISK_WRITE);
    if (f >= 0) {
        fileWriteStr(f, sprintf("%d", starts));
        fileClose(f);
    }

    var bg = alloc();
    target(bg);
    set(location, 0, 0);
    set(size, 1280, 800);
    set(bg_color, strcmp(id, "com.example.hello") == 0 ? 0x18C3 : 0x4208);
    parent(0);

    var title = alloc();
    target(title);
    set(kind, KIND_LABEL);
    set(location, 0, 200);
    set(size, 1280, 60);
    set(text, sprintf("App %s", id));
    set(text_color, WHITE);
    set(text_align, ALIGN_CENTER);
    parent(0);

    var info = alloc();
    target(info);
    set(kind, KIND_LABEL);
    set(location, 0, 280);
    set(size, 1280, 40);
    set(text, sprintf("started %d times (its own EEPROM)", starts));
    set(text_color, YELLOW);
    set(text_align, ALIGN_CENTER);
    parent(0);

    clock = alloc();
    target(clock);
    set(kind, KIND_LABEL);
    set(location, 0, 360);
    set(size, 1280, 40);
    set(text_color, GREEN);
    set(text_align, ALIGN_CENTER);
    parent(0);
    born = millis();

    tapButton(390, 430);

    home = alloc();
    quit = alloc();
    button(home, 290, "Home");
    button(quit, 690, "Exit");
    // set(on_click) wires file-scope widget variables.
    target(home);
    set(on_click, @on_button);
    target(quit);
    set(on_click, @on_button);
    return 0;
}

fn loop() {
    var sec = (millis() - born) / 1000;
    if (sec != shown_s) {
        shown_s = sec;
        target(clock);
        set(text, sprintf("running %d s", sec));
    }
}
